+def resolve_output_child(parent: Path, *parts: str) -> Path:
+    """Resolve a generated child and refuse symlink/path escapes."""
+    resolved_parent = parent.resolve(strict=True)
+    child = resolved_parent.joinpath(*parts).resolve(strict=False)
+    if not _is_relative_to(child, resolved_parent):
+        raise ValueError(f"output artifact escapes {resolved_parent}: {child}")
+    return child
+
