+def _resolve_json_output(path: str) -> Path:
+    candidate = Path(path).expanduser()
+    if not candidate.is_absolute():
+        candidate = Path.cwd() / candidate
+    output = candidate.resolve(strict=False)
+    try:
+        output.relative_to(BENCHMARK_REPORT_ROOT)
+    except ValueError as exc:
+        raise ValueError(
+            f"benchmark JSON must stay inside {BENCHMARK_REPORT_ROOT}: {output}"
+        ) from exc
+    if output.suffix.casefold() != ".json":
+        raise ValueError(f"benchmark output must use .json: {output}")
+    return output
+
