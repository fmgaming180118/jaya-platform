# ============================================================
# JAYA_CORE Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Sovereign Identity (REQUIRED) ───────────────────────────
# AES-256-GCM password used to encrypt/decrypt .jay soul files.
# This is the key to JAYA's cryptographic identity (Pillar 13).
JAYA_SOUL_PASSWORD=your-strong-password-here

# Path to the active .jay soul file (default: JAYA_SOVEREIGN_V18.jay)
JAYA_MODEL_PATH=

# ── Data Directories (Optional) ─────────────────────────────
# Base directory for CORE runtime data (default: JAYA_CORE/data/)
JAYA_CORE_DATA_DIR=

# Pillar 33 — Agentic RAG SQLite database path
JAYA_AGENTIC_RAG_PATH=

# Pillar 31 — Narrative Continuity persistence file
JAYA_NARRATIVE_PATH=

# ── Twin Protocol (Optional) ─────────────────────────────────
# Pillar 30 — Shared secret for P2P twin-to-twin handshakes.
# Auto-derived from JAYA_SOUL_PASSWORD if not set.
JAYA_TWIN_SHARED_SECRET=

# Unique node ID for this JAYA instance (auto-generated if empty)
JAYA_NODE_ID=

# ── Research Bridge (Optional) ────────────────────────────────
# Path to JAYA_RESEARCH evolution_memory.json for the discovery bridge.
# Enables research findings to flow into CORE's Agentic RAG.
JAYA_RESEARCH_MEMORY_PATH=
