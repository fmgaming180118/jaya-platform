+) -> None:
+    with pytest.raises(ValueError, match="inside"):
+        backup_source.resolve_contained(WORKSPACE_ROOT, root=CORE_ROOT)
+
+    monkeypatch.delenv("JAYA_BACKUP_MIRROR_DIR", raising=False)
