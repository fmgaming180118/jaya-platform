+CORE_ROOT = Path(__file__).resolve().parents[1]
+POLICY_ROOT = CORE_ROOT / "data" / "policies"
+EDGE_ROOT = CORE_ROOT / "data" / "edge_deploy"
+POLICY_NAME_PATTERN = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}\Z")
