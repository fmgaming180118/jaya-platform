# === JAYA RESEARCH AGENTIC ECOSYSTEM - GITIGNORE ===
# Clean production gitignore. Protects sensitive user data & omits internal blueprints/AI docs.

# ─── DOKUMENTASI & BLUEPRINT ────────────────────────────────────────────────
# Dokumentasi aktif di /docs dilacak. Arsip dan referensi besar tetap lokal.
docs/references/
docs/archive/*
!docs/archive/README.md
JAYA_CORE/docs/
JAYA_RESEARCH/docs/
JAYA_AGENT/docs/
JAYA_OS/docs/
JAYA_ANDROID/docs/
blueprint/
blueprints/
blueprint-*/
.agents/

# ─── ENVIRONMENT & SECRETS (JANGAN PERNAH COMMIT) ───────────────────────────
.env
.env.*
*.env
*.key
*.jay.key
secrets.yaml
configs/local_*.yaml
nvidia_nim_config.yaml

# ─── VIRTUAL ENVIRONMENTS & DEPENDENCIES ─────────────────────────────────────
.venv/
venv/
ENV/
.venv*/
**/.venv*/
**/venv*/
node_modules/
**/node_modules/

# ─── PYTHON & BUILD ARTIFACTS ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.o
*.obj
*.exp
*.lib
*.pdb
*.egg
*.egg-info/
dist/
build/
.eggs/
htmlcov/
# Kotlin/Gradle incremental compiler state (for example JAYA_ANDROID/.kotlin).
.kotlin/
.coverage
.pytest_cache/

# ─── DATA PRIBADI, RUNTIME & DATABASE (Data User & Vector Store) ────────────
data/
**/data/
# A package named `data` inside a source tree is code, not runtime user data.
# Re-include only source-file extensions; databases/uploads remain ignored.
!**/src/**/data/
!**/src/**/data/**/*.py
!**/src/**/data/**/*.kt
!**/src/**/data/**/*.java
!**/src/**/data/**/*.ts
workspaces/
**/workspaces/
logs/
**/logs/
backups/
**/backups/
reports/
**/reports/
sandbox_env/
**/sandbox_env/
jurnal_pdf/
**/jurnal_pdf/
data-training/
file-uji-coba/
scratch/
**/scratch/

# Database files & patches
*.db
*.sqlite
*.sqlite3
*.jaypatch
*.jay
*.pdf

# ─── LARGE MODEL BINARIES & WEIGHT ADAPTERS ──────────────────────────────────
*.pt
*.pth
*.bin
*.onnx
*.safetensors
*.gguf
adapters/
**/adapters/

# ─── TEST SCRIPTS & TEST ARTIFACTS ───────────────────────────────────────────
check_duplicates.py
cleanup_duplicates.py

# ─── UI & FRONTEND BUILD ─────────────────────────────────────────────────────
ui/dist/
ui/.vite/
ui/build/
ui/dist-electron/
ui/.output/
dist-electron/

# ─── TEMP FILES, LOGS & SCRATCH SCRIPTS ──────────────────────────────────────
*.log
*.tmp
*.bak
*.orig
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# Ignore temporary root test logs
approved_log*.txt
final_*.txt
jaya_data_list.txt
pip_install_log.txt
run_*.txt
sample_run.txt
verify_*.txt
tmp_*.py
