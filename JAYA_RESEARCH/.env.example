# NVIDIA NIM Configuration
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_VLM_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions

NVIDIA_LLAMA31_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_LLAMA31_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLAMA31_TEMPERATURE=0.6
NVIDIA_LLAMA31_TOP_P=0.95
NVIDIA_LLAMA31_MAX_TOKENS=1000000
NVIDIA_LLAMA31_FREQUENCY_PENALTY=0
NVIDIA_LLAMA31_PRESENCE_PENALTY=0
NVIDIA_LLAMA31_THINKING_MODE=true
NVIDIA_LLAMA31_TIMEOUT=300

# Shared provider safety limits (all retries are bounded to 1-10 attempts)
PROVIDER_CONNECT_TIMEOUT_SECONDS=5
PROVIDER_READ_TIMEOUT_SECONDS=30
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_RETRY_BASE_DELAY_SECONDS=0.25
PROVIDER_RETRY_MAX_DELAY_SECONDS=2

# Optional provider-specific overrides
NVIDIA_PROVIDER_READ_TIMEOUT_SECONDS=120
NVIDIA_EMBEDDING_PROVIDER_READ_TIMEOUT_SECONDS=30
WEB_SEARCH_PROVIDER_READ_TIMEOUT_SECONDS=15
ACADEMIC_PROVIDER_READ_TIMEOUT_SECONDS=30
NVIDIA_VLM_PROVIDER_READ_TIMEOUT_SECONDS=60

# RAG Configuration
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=128
RAG_EMBED_BATCH_SIZE=32
RAG_EMBED_DIMENSION=1024
RAG_EMBED_TIMEOUT_SECONDS=30
RAG_RERANK_ENABLED=false

# Academic download safety limit (50 MiB)
ACADEMIC_PDF_MAX_BYTES=52428800

# Video VLM generation controls
VIDEO_VLM_MAX_TOKENS=1024
VIDEO_VLM_TEMPERATURE=0.2
VIDEO_VLM_TOP_P=0.7

# Nemotron Ingest Configuration
NV_INGEST_HOST=localhost
NV_INGEST_PORT=7671

# Semantic Scholar
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1/paper

# Data Directories (Optional overrides, defaults to JAYA_RESEARCH/data/...)
JAYA_DATA_DIR=
VECTOR_STORE_PATH=
EVOLUTION_MEMORY_PATH=
DISCOVERY_MEMORY_PATH=
KNOWLEDGE_GRAPH_PATH=
NATIVE_MEMORY_PATH=
VIDEO_CACHE_DIR=
VOICE_PROFILES_DIR=
VOICE_SAMPLES_DIR=
VOICE_MODELS_DIR=

# QLoRA Hybrid (optional, training path)
OLLAMA_HOST=http://127.0.0.1:11434
QLORA_OLLAMA_MODEL=qwen3:4b
QLORA_BASE_MODEL=Qwen/Qwen3-4B-Instruct-2507

# Voice Agent Configuration (NVIDIA Riva / NIM)
NVIDIA_RIVA_URI=wss://riva.api.nvidia.com
