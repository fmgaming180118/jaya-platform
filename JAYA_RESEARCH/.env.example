# NVIDIA NIM Configuration
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

NVIDIA_LLAMA3.1_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1
NVIDIA_LLAMA3.1_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLAMA3.1_TEMPERATURE=0.6
NVIDIA_LLAMA3.1_TOP_P=0.95
NVIDIA_LLAMA3.1_MAX_TOKENS=16384
NVIDIA_LLAMA3.1_FREQUENCY_PENALTY=0
NVIDIA_LLAMA3.1_PRESENCE_PENALTY=0
NVIDIA_LLAMA3.1_THINKING_MODE=true
NVIDIA_LLAMA3.1_TIMEOUT=300

# RAG Configuration
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=128

# Nemotron Ingest Configuration
NV_INGEST_HOST=localhost
NV_INGEST_PORT=7671

# Voice Agent Configuration
# Voice Agent Configuration (NVIDIA Riva / NIM)
NVIDIA_RIVA_URI=wss://riva.api.nvidia.com

