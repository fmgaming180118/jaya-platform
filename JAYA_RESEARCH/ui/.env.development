# ============================================================
# JAYA Research UI - DEVELOPMENT Environment
# Digunakan oleh: Developer / Bos (npm run dev)
# ============================================================

# Mode Identifier (jangan diubah)
VITE_APP_MODE=development
VITE_APP_NAME=JAYA Research [DEV]
VITE_APP_VERSION=2.1.0

# API Backend URL (server lokal)
VITE_API_BASE_URL=http://localhost:8000
VITE_API_AUTH_MODE=required
JAYA_UI_API_TARGET=http://127.0.0.1:8000

# --- Dev Tools (AKTIF di DEV, NONAKTIF di PROD) ---
VITE_SHOW_DEV_BANNER=true
VITE_SHOW_DEV_PANEL=true
VITE_SHOW_API_LOGS=true
VITE_SHOW_ENV_INSPECTOR=true

# --- Feature Flags ---
VITE_ENABLE_JOURNAL_SEARCH=true
VITE_ENABLE_PDF_UPLOAD=true
VITE_ENABLE_RECURSIVE_RESEARCH=true
VITE_ENABLE_KNOWLEDGE_GRAPH=true
VITE_ENABLE_DIGITAL_TWIN=false
VITE_ENABLE_THESIS_MODE=true
VITE_ENABLE_SETTINGS_PAGE=true
