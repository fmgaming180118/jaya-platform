# ==============================================================================
# JAYA Research - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure the variables below.
# JAYA is designed to function out-of-the-box with local fallbacks even without
# external API keys. Providing API keys enables advanced cloud reasoning & search.
# ==============================================================================

# Server & Network Settings
JAYA_HOST=127.0.0.1
JAYA_PORT=8000
JAYA_ENVIRONMENT=production
JAYA_DEBUG=false

# Optional: NVIDIA NIM API (Reasoning, VLM, Embeddings, Ingestion)
# Get your key at: https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_nim_api_key_here

# Optional: OpenAI API Key (Alternative cloud reasoning provider)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Web Search Provider (tavily, serper, or none)
TAVILY_API_KEY=your_tavily_api_key_here

# Security Settings
# Generate a secure random token for bearer authentication:
JAYA_SECRET_KEY=generate_a_secure_random_key_here
