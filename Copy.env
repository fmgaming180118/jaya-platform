# ==============================================
# Memory Configuration
# ==============================================
# Qdrant Configuration (Legacy - deprecated, use Milvus instead)
# Mode: memory (no Docker/API needed) or server (requires Docker)
QDRANT_MODE=memory
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_HOT=memories_hot
QDRANT_COLLECTION_COLD=memories_cold

# Milvus Configuration (NVIDIA Blueprint - RECOMMENDED)
# Start Milvus: docker\start_milvus.bat
# GPU-accelerated vector search, no lock issues, concurrent access
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_HOT=hot
MILVUS_COLLECTION_COLD=cold
MILVUS_COLLECTION_RESEARCH=research
MILVUS_COLLECTION_CENTRAL=central

# Memory Settings
MEMORY_HOT_TTL_DAYS=7
MEMORY_SUMMARIZE_AFTER_HOURS=24
MEMORY_BACKEND=faiss
FAISS_STORAGE_PATH=storage/faiss
RAG_CONFIDENCE_THRESHOLD=0.35

# ==============================================
# Video Search & Summarization Configuration
# ==============================================
# Video Processing
ENABLE_VIDEO_SEARCH=true
VIDEO_CHUNK_DURATION=30  # Seconds per chunk
VIDEO_OVERLAP_DURATION=5  # Overlap between chunks
VIDEO_KEYFRAMES_PER_CHUNK=5  # Frames to extract per chunk
VIDEO_MAX_CONCURRENT_PROCESSING=3  # Parallel video processing

# VLM Models for Video Analysis
VIDEO_VLM_MODEL=nvidia/llama-3.2-90b-vision-instruct  # Frame analysis
VIDEO_CAPTION_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5  # Caption generation

# Milvus Video Collections
MILVUS_COLLECTION_VIDEO_CHUNKS=jaya_video_chunks
MILVUS_COLLECTION_VIDEO_METADATA=jaya_video_metadata

# YouTube API (for video discovery)
YOUTUBE_API_KEY=  # Optional: Add YouTube Data API v3 key

# Video Storage
VIDEO_STORAGE_PATH=data/videos  # Local video cache
VIDEO_MAX_CACHE_SIZE_GB=50  # Maximum disk space for videos

# ==============================================
# Computer Vision Pipeline Configuration
# ==============================================
# CV Pipeline Enable/Disable
CV_ENABLE=false  # Enable CV pipeline (requires Docker container running)
CV_PIPELINE_URL=http://localhost:8001  # CV pipeline API endpoint

# Model Paths (inside Docker container)
GDINO_ENGINE_PATH=/workspace/models/cv/swin.fp16.engine
TRACKER_CONFIG_PATH=/workspace/config/tracker_sam2.yml
FUSION_CONFIG_PATH=/workspace/config/MOT_EVAL_config_fusion.yml
SAM2_MODEL_PATH=/workspace/models/cv/sam2_large

# NGC Model Download
NGC_API_KEY=  # Add your NGC API key for model downloads

# CV Pipeline Parameters
CV_INFERENCE_INTERVAL=1  # Detect every N frames (1=all frames, 5=every 5th frame)
CV_BATCH_SIZE=4  # Batch size for CV inference
CV_GPU_ID=0  # GPU ID to use for CV pipeline
CV_MAX_CONCURRENT_CHUNKS=8  # Max parallel chunk processing
CV_BUFFER_POOL_SIZE=20  # DeepStream buffer pool size

# Detection Parameters
CV_CONFIDENCE_THRESHOLD=0.3  # Default confidence threshold (0.0-1.0)
CV_DEFAULT_PROMPTS=person,vehicle,animal  # Default detection classes (comma-separated)
CV_ENABLE_TRACKING=true  # Enable multi-object tracking
CV_ENABLE_SEGMENTATION=true  # Enable SAM2 segmentation masks

# Performance Tuning
CV_MAX_MEMORY_GB=8  # Max GPU memory for CV pipeline
CV_TIMEOUT_SECONDS=3600  # Max processing time per video (1 hour)

MEMORY_MAX_IMPORTANCE=1.0
MEMORY_MIN_IMPORTANCE=0.1

# ==============================================
# Storage Paths
# ==============================================
STORAGE_PATH=storage
QDRANT_STORAGE_PATH=storage/qdrant_data

