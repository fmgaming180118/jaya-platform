# ==============================================
# Tools Configuration
# ==============================================
GITHUB_TOKEN=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

# Tool Generation Limits (dapat diubah sesuai kebutuhan)
TOOL_MAX_DAILY=3000  # Target tools per hari (ubah sesuai kebutuhan)
TOOL_MAX_CONCURRENT=5  # Max tools dibuat bersamaan
TOOL_AUTO_GENERATE_BATCH=100  # Berapa tools yang auto-generate setiap run (ubah sesuai kebutuhan)
TOOL_GENERATION_RATE_LIMIT=40  # Max API requests per menit untuk tool generation

# 🤖 JARVIS Tool Discovery Mode
TOOL_DISCOVERY_MODE=auto  # auto = intelligent (prioritizes actual needs), explore = random search, improve = fix failing tools
TOOL_USAGE_TRACKING=true  # Track which tools are used vs unused
TOOL_AUTO_REMOVE_UNUSED=false  # Automatically remove tools unused for 30+ days (be careful!)

# 🌐 JARVIS Web Intelligence for Discovery  
TOOL_DISCOVERY_WEB_ENABLED=true  # Enable web search for tool discovery
TOOL_DISCOVERY_GITHUB_ENABLED=true  # Research GitHub trending repositories
TOOL_DISCOVERY_CREATIVE_MODE=true  # Enable creative thinking about useful tools
TOOL_DISCOVERY_MAX_SUGGESTIONS=20  # Max suggestions per discovery run
TOOL_DISCOVERY_MIN_CONFIDENCE=0.5  # Minimum confidence score to suggest (0.0-1.0)

# 🎯 JARVIS Never-Satisfied Mode
TOOL_DISCOVERY_NEVER_SATISFIED=true  # Always find MORE tools (true JARVIS behavior)
TOOL_DISCOVERY_SEARCH_CATEGORIES=10  # Number of categories to search per run
TOOL_DISCOVERY_GITHUB_TRENDING_LIMIT=5  # Max GitHub trending tools to research

# � JARVIS Continuous Discovery Mode (NON-STOP)
TOOL_CONTINUOUS_MODE_INTERVAL=5  # Seconds between cycles (FAST: 5 seconds, up to 40 req/min)
TOOL_CONTINUOUS_MODE_BATCH_SIZE=10  # Tools per cycle (can differ from TOOL_AUTO_GENERATE_BATCH)
TOOL_CONTINUOUS_MODE_AUTO_START=false  # Auto-start on system boot (dangerous!)

# �🛡️ JARVIS Security & Quality Filters
TOOL_DISCOVERY_SECURITY_CHECK=true  # Validate keamanan (block virus/malware domains)
TOOL_DISCOVERY_REQUIRE_ASCII_NAMES=true  # Tool names wajib ASCII (no Chinese chars)
TOOL_DISCOVERY_TRANSLATE_DESCRIPTIONS=true  # Auto-clean/translate descriptions ke EN/ID
TOOL_DISCOVERY_MAX_NON_ASCII_RATIO=0.3  # Max 30% non-ASCII di description (0.0-1.0)
TOOL_DISCOVERY_BLOCK_SUSPICIOUS_DOMAINS=true  # Block .cn, hack, crack, malware domains

# 🛡️ JARVIS Deduplication Settings
TOOL_DEDUPLICATION_ENABLED=true  # Prevent generating duplicate tools
TOOL_SIMILARITY_THRESHOLD=0.7  # Similarity threshold for duplicate detection (0.0-1.0)
EVOLUTION_DEDUPLICATION_ENABLED=true  # Prevent duplicate evolution topics
EVOLUTION_DUPLICATE_WINDOW_DAYS=7  # Days to check for duplicate topics (default: 7)

# GitHub Integration
EVOLUTION_GITHUB_ENABLED=true
EVOLUTION_GITHUB_MAX_RESULTS=10
EVOLUTION_GITHUB_SEARCH_TIMEOUT=15
EVOLUTION_GITHUB_CACHE_DURATION=3600

# ==============================================
# Evolution System Configuration (JARVIS Sandbox)
# ==============================================

# Model Router - Tiered Strategy
EVOLUTION_PRIMARY_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1
EVOLUTION_PRIMARY_TIMEOUT=300  # 5 minutes for Ultra 253B
EVOLUTION_FALLBACK_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
EVOLUTION_FALLBACK_TIMEOUT=120  # 2 minutes for Super 49B
EVOLUTION_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
EVOLUTION_VISION_TIMEOUT=180  # 3 minutes
EVOLUTION_CODER_MODEL=qwen/qwen3-coder-480b-a35b-instruct
EVOLUTION_CODER_TIMEOUT=240  # 4 minutes
EVOLUTION_CODER_FALLBACK=qwen/qwen2.5-coder-32b-instruct
EVOLUTION_CODER_FALLBACK_TIMEOUT=90  # 90 seconds

# Agent Configuration
EVOLUTION_ENABLE_BRAIN=true
EVOLUTION_ENABLE_RESEARCHER=true
EVOLUTION_ENABLE_LAB=true
EVOLUTION_ENABLE_CRITIC=true

# Learning System
EVOLUTION_LEARNING_DB=data/learning.db
EVOLUTION_TRACK_PERFORMANCE=true
EVOLUTION_MIN_TASKS_FOR_LEARNING=3

# Security
EVOLUTION_REQUIRE_APPROVAL=true  # Require manual approval for code changes
EVOLUTION_MAX_RISK_LEVEL=medium  # Reject critical/high risk changes
EVOLUTION_ENABLE_SANDBOX=true  # Run code in isolated sandbox

# Batch Processing
EVOLUTION_BATCH_SIZE=5  # Process 5 files at a time
EVOLUTION_ADAPTIVE_BATCHING=true  # Adjust batch size based on resources
EVOLUTION_MAX_MEMORY_MB=2048  # Max memory per batch

# Web Intelligence
EVOLUTION_MAX_SEARCH_RESULTS=10
EVOLUTION_DEEP_CRAWL_DEPTH=2
EVOLUTION_CRAWL_MAX_PAGES=20
EVOLUTION_RESEARCH_TIMEOUT=300  # 5 minutes for deep research

# Web Search & Crawler Configuration
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
WEB_CRAWL_TIMEOUT=10
WEB_CRAWL_DELAY=1.0
WEB_MEMORY_IMPORTANCE=0.8

# Simulation Factory
EVOLUTION_FACTORY_INTERVAL_HOURS=24  # Run improvement cycle every 24 hours
EVOLUTION_FACTORY_MAX_ITERATIONS=100  # Max iterations before stopping
EVOLUTION_FACTORY_MIN_IMPROVEMENT=0.05  # Minimum 5% improvement required

# 🤖 JARVIS Autonomous Mode
EVOLUTION_AUTONOMOUS_MODE=true  # true = evolve based on detected problems, false = scheduled only
EVOLUTION_MAX_HOURS_BETWEEN=168  # Max hours (168 = 1 week) before forcing evolution
EVOLUTION_CHECK_INTERVAL_MINUTES=30  # Check production health every X minutes

# Production Monitor
EVOLUTION_MONITOR_PRODUCTION=true  # Monitor production errors
EVOLUTION_AUTO_CREATE_TICKETS=true  # Auto-create tickets for production errors
EVOLUTION_CRITICAL_ERROR_PRIORITY=high  # Priority for critical errors
PRODUCTION_ERROR_THRESHOLD=10  # Trigger evolution if more than X errors detected
PRODUCTION_RECURRING_THRESHOLD=3  # Trigger evolution if X recurring errors detected

# Distributed Processing
EVOLUTION_ENABLE_DISTRIBUTED=false  # Enable distributed sandbox workers
EVOLUTION_MAX_WORKERS=3  # Maximum parallel workers
EVOLUTION_WORKER_TIMEOUT=3600  # 1 hour per worker

# Logging
EVOLUTION_LOG_LEVEL=INFO
EVOLUTION_LOG_FILE=logs/evolution.log
EVOLUTION_SAVE_PLANS=true  # Save improvement plans to disk
EVOLUTION_PLANS_DIR=data/plans

# ==============================================
# 🤖 JARVIS Intelligence Systems
# ==============================================

# Proactive Engine - Anticipate User Needs
JARVIS_PROACTIVE_ENABLED=true
JARVIS_PROACTIVE_CHECK_INTERVAL=300  # Check patterns every 5 minutes
JARVIS_PROACTIVE_MAX_SUGGESTIONS=5  # Max suggestions to show
JARVIS_PROACTIVE_CONFIDENCE_THRESHOLD=0.5  # Minimum confidence to show suggestion
JARVIS_MORNING_BRIEFING_ENABLED=true  # Auto-generate morning briefings
JARVIS_MORNING_BRIEFING_HOUR=6  # When to generate briefing (6 AM)

# Background Monitor - 24/7 Operation
JARVIS_BACKGROUND_MONITOR_ENABLED=true
JARVIS_HEALTH_CHECK_INTERVAL=60  # Check health every minute
JARVIS_OPTIMIZE_INTERVAL=1800  # Optimize resources every 30 minutes
JARVIS_AUTO_FIX_ENABLED=true  # Automatically fix  detected issues
JARVIS_CPU_THRESHOLD=90  # Trigger optimization at 90% CPU
JARVIS_MEMORY_THRESHOLD=85  # Trigger cleanup at 85% memory
JARVIS_ERROR_RATE_THRESHOLD=0.1  # 10% error rate = issue

# Predictive Monitor - Prevent Failures
JARVIS_PREDICTIVE_ENABLED=true
JARVIS_PREDICT_CHECK_INTERVAL=300  # Check for potential failures every 5 min
JARVIS_PREDICTION_CONFIDENCE_MIN=0.6  # Minimum confidence for predictions
JARVIS_FAILURE_ALERT_THRESHOLD=3600  # Alert if failure predicted within 1 hour
JARVIS_TREND_ANALYSIS_WINDOW=1440  # Analyze last 24 hours of metrics

# Pattern Learning - Understand Users
JARVIS_PATTERN_LEARNING_ENABLED=true
JARVIS_PATTERN_MIN_OBSERVATIONS=10  # Min interactions before learning patterns
JARVIS_PATTERN_CONFIDENCE_MIN=0.5  # Min confidence for pattern detection
JARVIS_PATTERN_UPDATE_INTERVAL=600  # Update patterns every 10 minutes
JARVIS_LEARN_FROM_FEEDBACK=true  # Learn from user feedback on suggestions

# User Profiles - Personalization
JARVIS_USER_PROFILES_ENABLED=true
JARVIS_PROFILE_AUTO_CREATE=true  # Auto-create profile on first interaction
JARVIS_PROFILE_SYNC_INTERVAL=300  # Save profiles every 5 minutes
JARVIS_PROFILE_INACTIVE_DAYS=30  # Archive profiles inactive for 30 days
JARVIS_SKILL_AUTO_DETECT=true  # Auto-detect user skill level

# Context Awareness
JARVIS_CONTEXT_MEMORY_SIZE=10  # Remember last 10 topics per user
JARVIS_CONTEXT_TIME_DECAY=true  # Older context has less weight
JARVIS_CONTEXT_CROSS_SESSION=true  # Remember context across sessions

# Autonomous Actions
JARVIS_AUTONOMOUS_ACTIONS_ENABLED=true
JARVIS_AUTONOMOUS_OPTIMIZATION=true  # Auto-optimize without asking
JARVIS_AUTONOMOUS_CLEANUP=true  # Auto-clean old logs/cache
JARVIS_AUTONOMOUS_MEMORY_MANAGEMENT=true  # Auto-manage memory usage
JARVIS_AUTONOMOUS_ERROR_FIXING=false  # Auto-fix errors (set false for safety)
JARVIS_ACTION_LOG_RETENTION_DAYS=30  # Keep action logs for 30 days

# Intelligence Limits
JARVIS_MAX_DAILY_SUGGESTIONS=50  # Max suggestions per user per day
JARVIS_MAX_DAILY_PREDICTIONS=20  # Max failure predictions per day
JARVIS_MAX_AUTONOMOUS_ACTIONS=100  # Max autonomous actions per day
JARVIS_ACTION_APPROVAL_REQUIRED=false  # Require approval for critical actions

# Storage Paths
JARVIS_DATA_PATH=data/jarvis
JARVIS_PATTERNS_PATH=data/patterns
JARVIS_PROFILES_PATH=data/profiles
JARVIS_MONITOR_PATH=data/monitor
JARVIS_PREDICTIVE_PATH=data/predictive

# Performance Tuning
JARVIS_ASYNC_ENABLED=true  # Use async operations
JARVIS_PARALLEL_PROCESSING=true  # Process multiple users in parallel
JARVIS_CACHE_ENABLED=true  # Cache frequently used data
JARVIS_CACHE_TTL=3600  # Cache TTL in seconds (1 hour)
