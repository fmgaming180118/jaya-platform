    "silence_reasons": ["OWNER_STOP", "RESOURCE_PRESSURE", "PRIVACY_BOUNDARY", "PERMISSION_REVOKED", "IDLE", "SAFETY_VIOLATION", "INSUFFICIENT_EVIDENCE", "AMBIGUOUS_REQUEST", "PROVIDER_UNAVAILABLE"],
    "wake_sources": ["OWNER_REQUEST", "RESOURCE_RECOVERED", "PRIVACY_RELEASED", "PERMISSION_RESTORED", "TASK_RECEIVED"],
    "allowed_services": ["audit", "cancellation", "checkpoint", "healthcheck", "resource_monitor"],
    "forbidden_services": ["model_generation", "network", "tool_execution", "proactive_scheduler"]
