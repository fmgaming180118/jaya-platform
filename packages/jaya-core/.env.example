# ============================================================
# JAYA_CORE Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Sovereign Identity (REQUIRED) ───────────────────────────
# AES-256-GCM password used to encrypt/decrypt .jay soul files.
# This is the key to JAYA's cryptographic identity (Pillar 13).
JAYA_SOUL_PASSWORD=your-strong-password-here

# Path to the active .jay soul file (default: data/models/jaya-core/JAYA_SOVEREIGN_V18.jay)
JAYA_MODEL_PATH=
# Core tetap dapat hidup tanpa model. Aktifkan hanya bila deployment ini wajib
# mempunyai puzzle/model artifact tertentu.
JAYA_REQUIRE_MODEL=false

# DNA Anchor (Pillar 11). Enrollment is explicit; Core never generates a new
# authorized identity during boot. Keep the unlock secret in a secret manager.
JAYA_REQUIRE_IDENTITY=false
JAYA_IDENTITY_KEY_SECRET=
# Must remain within JAYA_CORE_DATA_DIR. Default: <data>/identity
JAYA_IDENTITY_DIR=
JAYA_REQUIRE_PRIVACY=false
JAYA_PRIVACY_KEY_SECRET=
JAYA_REQUIRE_ZERO_TRUST=false

# Cryptographic Skin (Pillar 13). Requires an enrolled DNA Anchor so every
# AES-256-GCM envelope also carries a verifiable Ed25519 DNA attestation.
JAYA_REQUIRE_CRYPTOGRAPHIC_SKIN=false
JAYA_CRYPTOGRAPHIC_SKIN_SECRET=

# Hardware Locked (Pillar 14). Requires P11 and P13. Enrollment must happen
# explicitly before boot; the launcher never trusts a hostname/MAC fallback.
JAYA_REQUIRE_HARDWARE_LOCK=false

# Immune System (Pillar 12). Requires P18 Zero Trust and P13 Cryptographic
# Skin. Registered artifacts and dependency circuits persist across restarts.
JAYA_REQUIRE_IMMUNE_SYSTEM=false

# Quantum Security (Pillar 16). Install requirements-pq.txt first. Production
# fails closed if liboqs ML-DSA-65 is unavailable; no classical fallback.
JAYA_REQUIRE_QUANTUM_SECURITY=false
JAYA_QUANTUM_POLICY_VERSION=1
JAYA_QUANTUM_ASSET_LIFETIME_DAYS=3650
JAYA_QUANTUM_THREAT_HORIZON_YEAR=2035
JAYA_QUANTUM_CLASSICAL_CUTOFF_YEAR=2028

# ── Data Directories (Optional) ─────────────────────────────
# Base directory for Core runtime data (default: data/jaya-core/)
JAYA_CORE_DATA_DIR=

# Pillar 33 — Agentic RAG SQLite database path
JAYA_AGENTIC_RAG_PATH=

# Pillar 31 — signed append-only SQLite ledger. Requires an enrolled DNA
# Anchor; a legacy .json path is migrated to a sibling .sqlite3 database.
JAYA_NARRATIVE_PATH=
JAYA_NARRATIVE_MAX_PAYLOAD_BYTES=65536

# Pillar 25 — local HMAC key for the persistent epigenetic lineage ledger.
# Leave empty to keep this capability unavailable. Use a unique secret with
# at least 32 characters and manage it outside source control.
JAYA_LINEAGE_SIGNING_KEY=

# Pillar 7 — durable Cognitive Silence transition ledger. When empty, Core
# uses <JAYA_CORE_DATA_DIR>/cognitive_silence.sqlite.
JAYA_COGNITIVE_SILENCE_DB_PATH=
# Allowed interval: (0, 1]. This is the activation ratio retained in silence.
JAYA_COGNITIVE_SILENCE_TOPK=0.02
# Maximum serialized checkpoint size; must be at least 1024 bytes.
JAYA_COGNITIVE_SILENCE_MAX_CHECKPOINT_BYTES=262144

# Pillar 10 — bounded affective control policy. These variables describe
# runtime control, not human emotion or inferred user identity.
JAYA_AFFECTIVE_MAX_DELTA=0.25
JAYA_AFFECTIVE_DECAY_HALF_LIFE_SECONDS=300
JAYA_AFFECTIVE_CONFIRMATION_THRESHOLD=0.70
JAYA_AFFECTIVE_ESCALATION_THRESHOLD=0.75

# Pillar 6 — explicit opt-in only. The GGUF model is loaded lazily on the first
# authorized request; no cloud or rule-based fallback is used.
JAYA_SPONTANEITY_ENABLED=false
JAYA_SPONTANEITY_LOCAL_MODEL_PATH=
# Empty uses <JAYA_CORE_DATA_DIR>/spontaneity.sqlite.
JAYA_SPONTANEITY_DB_PATH=

# Pillar 17 — evidence catalog and durable review receipts.
# Evidence defaults to <JAYA_CORE_DATA_DIR>/library.db (read-only access).
JAYA_SOCRATIC_EVIDENCE_DB_PATH=
# Audit defaults to <JAYA_CORE_DATA_DIR>/socratic.sqlite.
JAYA_SOCRATIC_AUDIT_DB_PATH=
JAYA_SOCRATIC_RISK_THRESHOLD=0.60
JAYA_SOCRATIC_UNCERTAINTY_THRESHOLD=0.50
JAYA_SOCRATIC_NOVELTY_THRESHOLD=0.70
JAYA_SOCRATIC_IMPACT_THRESHOLD=0.60
JAYA_SOCRATIC_TIMEOUT_SECONDS=3.0

# ── Twin Protocol (Optional) ─────────────────────────────────
# Pillar 30 — Shared secret for P2P twin-to-twin handshakes.
# Required in production when JAYA_ENABLE_TWIN=true; never auto-derived.
JAYA_TWIN_SHARED_SECRET=

# Unique node ID for this JAYA instance (auto-generated if empty)
JAYA_NODE_ID=

# Core HTTP service. Production requires every bind/trusted-host field and a
# unique API key of at least 32 characters. Protected routes are unavailable
# when the key is absent in development.
JAYA_CORE_API_KEY=
JAYA_CORE_BIND_HOST=127.0.0.1
JAYA_CORE_BIND_PORT=8765
JAYA_CORE_TRUSTED_HOSTS=localhost,127.0.0.1

# Empty denies all cross-origin requests. Use exact comma-separated origins;
# wildcard origins are rejected and production origins must use HTTPS.
JAYA_CORE_CORS_ORIGINS=

# Maximum Core runtime response time in seconds (0.1 through 300).
JAYA_CORE_REQUEST_TIMEOUT_SECONDS=30

# Enable the twin explicitly. Production then requires its secret and node ID.
JAYA_ENABLE_TWIN=false

# ── Evolution Gate (Required in production) ──────────────────
# Runtime environment: development or production.
JAYA_ENVIRONMENT=development

# Minimum 32-byte secrets. Keep both empty in local development to use
# process-lifetime ephemeral keys. Production fails closed when either is empty.
JAYA_EVOLUTION_SIGNING_KEY=
JAYA_EVOLUTION_EVIDENCE_SIGNING_KEY=

# Comma-separated CI runner identities allowed to issue evidence reports.
JAYA_EVOLUTION_TRUSTED_RUNNERS=

# Optional commit that promotion scripts must match in both signed reports.
JAYA_EVOLUTION_EXPECTED_COMMIT=

# ── Research Bridge (Optional) ────────────────────────────────
# Core-owned inbox for artifacts promoted through the public Research contract.
# The resolved path must remain inside JAYA_CORE_DATA_DIR.
JAYA_RESEARCH_INBOX_PATH=

# ── Cloud LLM Providers (Optional) ───────────────────────────
# Enable cloud LLM integration (default: true)
JAYA_ENABLE_CLOUD=true

# Privacy level: STRICT_LOCAL_ONLY, HYBRID_ALLOWED, ANONYMIZED_CLOUD_ALLOWED
JAYA_PRIVACY_LEVEL=HYBRID_ALLOWED

# Default cloud provider: openai, anthropic, ollama, custom
JAYA_CLOUD_DEFAULT_PROVIDER=openai

# OpenAI Configuration
JAYA_OPENAI_API_KEY=
JAYA_OPENAI_BASE_URL=https://api.openai.com
JAYA_OPENAI_MODEL=gpt-4o-mini
JAYA_OPENAI_TIMEOUT=30
JAYA_OPENAI_MAX_TOKENS=1024
JAYA_OPENAI_TEMPERATURE=0.7

# Anthropic Configuration
JAYA_ANTHROPIC_API_KEY=
JAYA_ANTHROPIC_BASE_URL=https://api.anthropic.com
JAYA_ANTHROPIC_MODEL=claude-3-haiku-20240307
JAYA_ANTHROPIC_TIMEOUT=30
JAYA_ANTHROPIC_MAX_TOKENS=1024
JAYA_ANTHROPIC_TEMPERATURE=0.7

# Ollama Configuration (local or remote)
JAYA_OLLAMA_BASE_URL=
JAYA_OLLAMA_API_KEY=
JAYA_OLLAMA_MODEL=llama3.1:8b
JAYA_OLLAMA_TIMEOUT=60
JAYA_OLLAMA_MAX_TOKENS=1024
JAYA_OLLAMA_TEMPERATURE=0.7

# Pillar 22 trained ternary artifact (generate with scripts/train_ternary_transition_model.py)
JAYA_TERNARY_MODEL_PATH=
JAYA_TERNARY_MODEL_SHA256=

# Custom OpenAI-Compatible Endpoint
JAYA_CUSTOM_LLM_BASE_URL=
JAYA_CUSTOM_LLM_API_KEY=
JAYA_CUSTOM_LLM_MODEL=custom-model
JAYA_CUSTOM_LLM_TIMEOUT=30
JAYA_CUSTOM_LLM_MAX_TOKENS=1024
JAYA_CUSTOM_LLM_TEMPERATURE=0.7
