# ============================================================
# JAYA Research UI - PRODUCTION Environment
# Digunakan oleh: Pengguna Umum (npm run build)
# ============================================================

# Mode Identifier (jangan diubah)
VITE_APP_MODE=production
VITE_APP_NAME=JAYA Research
VITE_APP_VERSION=2.1.0

# API Backend URL (gunakan relative path agar bisa di-deploy di mana saja)
VITE_API_BASE_URL=/api
VITE_API_AUTH_MODE=required
JAYA_UI_API_TARGET=http://127.0.0.1:8000

# --- Dev Tools (SEMUA DINONAKTIFKAN di PROD) ---
VITE_SHOW_DEV_BANNER=false
VITE_SHOW_DEV_PANEL=false
VITE_SHOW_API_LOGS=false
VITE_SHOW_ENV_INSPECTOR=false

# --- Feature Flags (bisa dikontrol mana yg aktif di PROD) ---
VITE_ENABLE_JOURNAL_SEARCH=true
VITE_ENABLE_PDF_UPLOAD=true
VITE_ENABLE_RECURSIVE_RESEARCH=true
VITE_ENABLE_KNOWLEDGE_GRAPH=true
VITE_ENABLE_DIGITAL_TWIN=false
VITE_ENABLE_THESIS_MODE=true
VITE_ENABLE_SETTINGS_PAGE=false
